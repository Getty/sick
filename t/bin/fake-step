#!/usr/bin/env perl
use strict;
use warnings;
use JSON::PP;

# A stand-in for the step command line, for t/21-issuer-stepca.t and
# t/43-report.t.
#
# It knows "ca certificate", "ca sign" and "ca health" with the flags the
# real step defines for them, records every call as one line of JSON, and
# hands out the files of a test CA instead of talking to one.
#
# Modelled on step 0.30.2 against a step-ca 0.30.2, as observed:
#
# - progress goes to standard error, in colour also without a terminal:
#   "<check mark> Provisioner: sick (JWK) [kid: ...]", "<check mark> CA: <url>",
#   and after a success one line per file that was written;
# - a --root file with more than one PEM block is refused;
# - --not-after takes an RFC 3339 time or a Go duration (ns, us, ms, s, m,
#   h - no days);
# - --size goes with --kty RSA only, --curve with --kty EC only, and an RSA
#   key has at least 2048 bits;
# - "ca sign" has neither --san nor the key flags;
# - every failure is exit code 1.
#
# "ca health", observed with step 0.30.2 on 2026-10-10:
#
# - it knows --ca-url, --root and --context and nothing else ("flag
#   provided but not defined: -provisioner", then its help);
# - without --ca-url: "'step ca health' requires the '--ca-url' flag",
#   without --root: "'step ca health' requires the '--root' flag" (with
#   neither in $STEPPATH/config/defaults.json);
# - a --root file that is not there: "error reading <file>: open <file>: no
#   such file or directory"; a file with two PEM blocks is NOT refused here;
# - a healthy step-ca 0.30.2: "ok" and a newline on standard output, nothing
#   on standard error, exit code 0;
# - nothing listening: "client GET https://127.0.0.1:1/health failed: dial
#   tcp 127.0.0.1:1: connect: connection refused" on standard error, nothing
#   on standard output, exit code 1; another CA behind the URL: "client GET
#   <url>/health failed: tls: failed to verify certificate: x509:
#   certificate signed by unknown authority", exit code 1;
# - an address that drops the packets: still waiting after 5 seconds.
#
# The fake answers "ok" unless FAKE_STEP_EXIT is set; it never connects.
#
#   FAKE_STEP_LOG       file the calls are appended to
#   FAKE_STEP_FIXTURES  directory with fullchain.pem and key.pem (for
#                       "ca certificate") and signed.pem (for "ca sign")
#   FAKE_STEP_EXIT      exit with this code instead, after printing
#   FAKE_STEP_STDERR    this text to standard error
#
# The content of the password file is never read, let alone recorded.

my %FLAGS = (
  common => {
    '--ca-url'                    => 1,
    '--root'                      => 1,
    '--provisioner'               => 1,
    '--issuer'                    => 1,
    '--provisioner-password-file' => 1,
    '--not-before'                => 1,
    '--not-after'                 => 1,
    '--set'                       => 1,
    '--set-file'                  => 1,
    '--token'                     => 1,
    '--context'                   => 1,
    '--password-file'             => 1,
    '--ca-config'                 => 1,
    '--force'                     => 0,
    '-f'                          => 0,
    '--offline'                   => 0,
    '--console'                   => 0
  },
  certificate => { '--san' => 1, '--kty' => 1, '--curve' => 1, '--crv' => 1, '--size' => 1 },
  sign        => {},
  health      => { '--ca-url' => 1, '--root' => 1, '--context' => 1 }
);
my %POSITIONALS = ( certificate => 3, sign => 2, health => 0 );

sub fail {
  my ( $message, $code ) = @_;
  print STDERR $message, "\n";
  exit( defined $code ? $code : 1 );
}

# A line of progress, the way step prints it.
sub progress {
  my ( $what, $value ) = @_;
  print STDERR "\e[32m\e[32m\xe2\x9c\x94\e[0m \e[1m", $what, "\e[0m\e[1m:\e[0m ", $value, "\n";
}

sub slurp {
  my ( $path ) = @_;
  open my $in, '<', $path or return;
  local $/;
  return scalar <$in>;
}

sub mode_of { my @stat = stat $_[0]; return @stat ? sprintf( '%04o', $stat[2] & 07777 ) : undef }

sub copy {
  my ( $from, $to ) = @_;
  open my $in, '<', $from or fail( 'fake-step: cannot read '.$from.': '.$! );
  my $content = do { local $/; <$in> };
  open my $out, '>', $to or fail( 'fake-step: cannot write '.$to.': '.$! );
  print {$out} $content;
  close $out or fail( 'fake-step: cannot write '.$to.': '.$! );
}

my @argv = @ARGV;
my %call = ( argv => [@argv], umask => sprintf( '%04o', umask ) );

fail('fake-step: only "ca certificate", "ca sign" and "ca health" are implemented')
  unless @argv >= 2 && $argv[0] eq 'ca' && exists $POSITIONALS{ $argv[1] };
my $command = $argv[1];
my @rest    = @argv[ 2 .. $#argv ];
my %known   = $command eq 'health' ? %{ $FLAGS{health} } : ( %{ $FLAGS{common} }, %{ $FLAGS{$command} } );

my ( %flag, @positional );
while (@rest) {
  my $arg = shift @rest;
  unless ( $arg =~ /\A-/ ) {
    push @positional, $arg;
    next;
  }
  my ( $name, $value ) = $arg =~ /\A(--?[^=]+)=(.*)\z/s ? ( $1, $2 ) : ( $arg, undef );
  ( my $shown = $name ) =~ s/\A-+//;
  fail( 'flag provided but not defined: -'.$shown ) unless exists $known{$name};
  if ( $known{$name} ) {
    $value = shift @rest unless defined $value;
    fail( 'flag needs an argument: -'.$shown ) unless defined $value;
    push @{ $flag{$name} }, $value;
  }
  else {
    $flag{$name} = [1];
  }
}

fail( 'too '.( @positional < $POSITIONALS{$command} ? 'few' : 'many' ).' positional arguments were provided' )
  unless @positional == $POSITIONALS{$command};

$call{command}    = $command;
$call{flags}      = \%flag;
$call{positional} = \@positional;

if ( my $password_file = $flag{'--provisioner-password-file'} && $flag{'--provisioner-password-file'}[0] ) {
  $call{password_file_readable} = -r $password_file ? 1 : 0;
}

# what the real step checks before it talks to the CA
my $one = sub { my ( $name ) = @_; return $flag{$name} ? $flag{$name}[-1] : undef };

sub record {
  return unless defined $ENV{FAKE_STEP_LOG};
  open my $log, '>>', $ENV{FAKE_STEP_LOG} or fail( 'fake-step: cannot write log: '.$! );
  print {$log} JSON::PP->new->canonical->encode( \%call ), "\n";
  close $log;
}

if ( $command eq 'health' ) {
  for my $name ( '--ca-url', '--root' ) {
    fail( '\'step ca health\' requires the \''.$name.'\' flag' ) unless defined $one->($name);
  }
  my $root = $one->('--root');
  fail( 'error reading '.$root.': open '.$root.': no such file or directory' ) unless defined slurp($root);
  record();
  if ( $ENV{FAKE_STEP_EXIT} ) {
    print STDERR $ENV{FAKE_STEP_STDERR} if defined $ENV{FAKE_STEP_STDERR};
    exit $ENV{FAKE_STEP_EXIT};
  }
  print "ok\n";
  exit 0;
}
my $kty = defined $one->('--kty') ? $one->('--kty') : 'EC';
my $crv = defined $one->('--curve') ? $one->('--curve') : $one->('--crv');
if ( $command eq 'certificate' ) {
  fail('flag \'--kty\' must be one of EC, OKP or RSA') unless $kty =~ /\A(?:EC|OKP|RSA)\z/;
  fail( 'flag \'--curve\' is incompatible with flag \'--kty '.$kty.'\'' ) if defined $crv && $kty eq 'RSA';
  fail( 'flag \'--size\' is incompatible with flag \'--kty '.$kty.'\'' ) if defined $one->('--size') && $kty ne 'RSA';
  fail('flag \'--size\' requires at least 2048 unless \'--insecure\' flag is provided')
    if defined $one->('--size') && $one->('--size') < 2048;
}
for my $name ( '--not-before', '--not-after' ) {
  my $value = $one->($name);
  next unless defined $value;
  fail( 'invalid value \''.$value.'\' for flag \''.$name.'\'' )
    unless $value =~ /\A[+-]?(?:[0-9]+(?:\.[0-9]+)?(?:ns|us|ms|s|m|h))+\z/
    || $value =~ /\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})\z/;
}

progress( 'Provisioner', ( defined $one->('--provisioner') ? $one->('--provisioner') : 'unknown' ).' (JWK) [kid: fake-step]' );
if ( defined( my $root = $one->('--root') ) ) {
  my $pem = slurp($root);
  fail( 'error reading '.$root.': no such file or directory' ) unless defined $pem;
  my $blocks = () = $pem =~ /-----BEGIN /g;
  fail( 'error decoding '.$root.': contains more than one PEM encoded block' ) if $blocks > 1;
}
progress( 'CA', defined $one->('--ca-url') ? $one->('--ca-url') : 'https://fake-step.invalid' );

my $fixtures = $ENV{FAKE_STEP_FIXTURES};

if ( !$ENV{FAKE_STEP_EXIT} ) {
  fail('fake-step: FAKE_STEP_FIXTURES is not set') unless defined $fixtures;
  if ( $command eq 'certificate' ) {
    my ( $subject, $cert, $key ) = @positional;
    copy( $fixtures.'/fullchain.pem', $cert );
    copy( $fixtures.'/key.pem',       $key );
    progress( 'Certificate', $cert );
    progress( 'Private Key', $key );
    ( my $dir = $key ) =~ s{/[^/]+\z}{};
    $call{key_file} = $key;
    $call{key_mode} = mode_of($key);
    $call{dir}      = $dir;
    $call{dir_mode} = mode_of($dir);
  }
  else {
    my ( $csr, $cert ) = @positional;
    open my $in, '<', $csr or fail( 'fake-step: cannot read '.$csr.': '.$! );
    my $request = do { local $/; <$in> };
    $call{csr_is_pem} = $request =~ /BEGIN (?:NEW )?CERTIFICATE REQUEST/ ? 1 : 0;
    copy( $fixtures.'/signed.pem', $cert );
    progress( 'Certificate', $cert );
    ( my $dir = $cert ) =~ s{/[^/]+\z}{};
    $call{dir}      = $dir;
    $call{dir_mode} = mode_of($dir);
    $call{csr_mode} = mode_of($csr);
  }
}

record();

if ( $ENV{FAKE_STEP_EXIT} ) {
  print STDERR $ENV{FAKE_STEP_STDERR} if defined $ENV{FAKE_STEP_STDERR};
  exit $ENV{FAKE_STEP_EXIT};
}

exit 0;
